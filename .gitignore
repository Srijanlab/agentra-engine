.venv/
__pycache__/
*.pyc
*.egg-info/
agentra/web/node_modules/
agentra/web/dist/
agentra/web/*.tsbuildinfo
# Only per-run logs are meant to be ignored here -- everything else under
# .agentra/ (memory/, shipped.json, known_bugs.json, feature_queue.json,
# objective.yaml, environments.yaml, standups/) is deliberately git-tracked
# audit trail per agentra/memory.py's own design. A blanket `.agentra/`
# rule here silently swallowed all of it -- git never even sees inside an
# ignored directory, so registry.commit_and_push() found "nothing dirty"
# to push every time, discovered live once agentra was registered against
# its own repo. The beta branch had forked from main before this fix
# landed there, so it needed the same fix applied directly too -- three
# real autonomous-cycle commits landed on beta with zero .agentra/ audit
# trail before that was caught.
.agentra/logs/
.claude_oauth_token
.github_pat
.claude/
deploy/gcp/terraform/.terraform/
deploy/gcp/terraform/terraform.tfstate
deploy/gcp/terraform/terraform.tfstate.backup
deploy/gcp/terraform/*.tfplan
deploy/gcp/terraform/tfplan_*
deploy/cloudflare/.env
deploy/cloudflare/terraform/.terraform/
deploy/cloudflare/terraform/terraform.tfstate
deploy/cloudflare/terraform/terraform.tfstate.backup
deploy/cloudflare/terraform/terraform.tfvars
deploy/cloudflare/terraform/*.tfplan
deploy/cloudflare/terraform/tfplan_*
slack-credentials.txt

build/
*.egg-info/
.venv/
.vercel
