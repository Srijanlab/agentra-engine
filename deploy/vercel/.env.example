# agentra-engine Vercel env vars. Set every var in BOTH environments:
#   Production (main -> prod)   and   Preview (beta -> pre-prod)
# via `bash deploy/vercel/set-env.sh` or the Vercel dashboard.
# GCP Secret Manager is billing-gated, so secrets live here, not there.

# --- non-secret ---
AGENTRA_FIRESTORE_PROJECT=agentra-prod
FIREBASE_PROJECT_ID=agentra-prod
AGENTRA_ALLOWED_EMAILS=you@example.com,teammate@example.com

# Shared bearer token for /internal/* (the agentra-loop RPC). Same value goes
# in the loop's AWS Secrets Manager. Generate: openssl rand -hex 32
AGENTRA_INTERNAL_TOKEN=
GCP_WORKLOAD_IDENTITY_CONFIG={"type":"external_account", ...see README...}

# --- GitHub: the agentra-orchestrator GitHub App (primary auth) ---
GITHUB_APP_ID=0000000
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# optional PAT fallback (repo scope), only if the App is unavailable
GITHUB_TOKEN=

# --- Slack ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-

# optional: Basic-auth password for /trigger/alarm (unset leaves it open)
ALARM_WEBHOOK_PASSWORD=
